# ==============================================================================
# Multi-Stage Dockerfile for ClinixVault Clinical Document & OCR Server
# Stage 1: Build virtual environment, install PyMuPDF and OCR packages
# Stage 2: Hardened, non-root minimal runtime image with Tesseract OCR engine
# ==============================================================================

# ----------------- Stage 1: Build & Compilation Stage -----------------
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    tesseract-ocr \
    tesseract-ocr-eng \
    libmupdf-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    fastapi>=0.110.0 \
    uvicorn>=0.28.0 \
    pydantic>=2.6.0 \
    PyMuPDF>=1.23.26 \
    pypdf>=4.0.0 \
    pytesseract>=0.3.10 \
    pillow>=10.2.0 \
    psutil>=5.9.8 \
    numpy>=1.26.0

# ----------------- Stage 2: Production Runtime Stage -----------------
FROM python:3.11-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10001 clinix && \
    useradd -u 10001 -g clinix -s /bin/bash -m appuser

COPY --from=builder /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH=/app

COPY inference/document_server /app/inference/document_server
COPY inference/shared /app/inference/shared

RUN chown -R appuser:clinix /app

USER appuser

EXPOSE 8004

HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8004/health || exit 1

CMD ["uvicorn", "inference.document_server.server:app", "--host", "0.0.0.0", "--port", "8004"]
