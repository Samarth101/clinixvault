# ==============================================================================
# Multi-Stage Dockerfile for ClinixVault React Frontend
# Stage 1: Build static assets using Node.js
# Stage 2: Serve high-performance production assets using non-root Nginx
# ==============================================================================

# ----------------- Stage 1: Node Builder -----------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package descriptors for layer caching
COPY frontend/package*.json ./
RUN npm ci

# Copy full frontend source code and compile
COPY frontend/ ./
RUN npm run build

# ----------------- Stage 2: Nginx Minimal Runtime -----------------
FROM nginx:alpine-slim

# Install curl for healthcheck probe
RUN apk add --no-cache curl

# Remove default static pages and configure custom SPA nginx configuration
RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deployment/dockerfiles/nginx.conf /etc/nginx/conf.d/default.conf

# Security Hardening: configure non-root user permissions for nginx
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d

USER nginx

EXPOSE 5173

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5173/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
