# ==============================================================================
# Multi-Stage Dockerfile for ClinixVault LLM Scribe & Summarization Server
# Stage 1: Build virtual environment, install llama.cpp/Outlines, compile C++ kernels
# Stage 2: Hardened, non-root minimal runtime image with healthcheck probe
# ==============================================================================

# ----------------- Stage 1: Build & Compilation Stage -----------------
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    fastapi>=0.110.0 \
    uvicorn>=0.28.0 \
    pydantic>=2.6.0 \
    psutil>=5.9.8 \
    numpy>=1.26.0 \
    outlines>=0.0.34 \
    llama-cpp-python>=0.2.75

COPY inference/cpp /app/inference/cpp
RUN cd /app/inference/cpp && make clean && make

# ----------------- Stage 2: Production Runtime Stage -----------------
FROM python:3.11-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10001 clinix && \
    useradd -u 10001 -g clinix -s /bin/bash -m appuser

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app/inference/cpp /app/inference/cpp

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH=/app

COPY inference/llm_server /app/inference/llm_server
COPY inference/shared /app/inference/shared

RUN chown -R appuser:clinix /app

USER appuser

EXPOSE 8002

HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

CMD ["uvicorn", "inference.llm_server.server:app", "--host", "0.0.0.0", "--port", "8002"]
