vault_audit_records/

# Large Model Checkpoints & Pretrained Weights
# (Checkpoints are managed via Hugging Face Hub: scripts/push_models_to_hf.py)
models/
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx
*.h5
*.ckpt
*.tflite
checkpoints/**/*.safetensors
checkpoints/**/*.pt
checkpoints/**/*.bin
checkpoints/**/optimizer.pt
checkpoints/**/scheduler.pt

# Preserve checkpoint config files and cards in git
!checkpoints/**/config.json
!checkpoints/**/adapter_config.json
!checkpoints/**/tokenizer_config.json
!checkpoints/**/tokenizer.json
!checkpoints/**/processor_config.json
!checkpoints/**/special_tokens_map.json
!checkpoints/**/chat_template.jinja
!checkpoints/**/README.md
!checkpoints/**/*.json
