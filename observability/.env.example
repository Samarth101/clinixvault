# ==============================================================================
# ClinixVault Observability - Grafana Labs (Grafana Cloud) Credentials
# ==============================================================================
# How to obtain these credentials:
# 1. Sign up for a free Grafana Cloud account at: https://grafana.com/auth/sign-up/create-user
# 2. Go to your Cloud Portal: https://grafana.com/orgs/<your-org-name>
# 3. For Prometheus: Under "Prometheus", click "Send Metrics" / "Details":
#    - Copy "Remote Write Endpoint" -> GRAFANA_CLOUD_PROMETHEUS_URL
#    - Copy "Username / Instance ID" -> GRAFANA_CLOUD_PROMETHEUS_USER
# 4. For Loki (Logs): Under "Loki", click "Send Logs" / "Details":
#    - Copy "URL" -> GRAFANA_CLOUD_LOKI_URL
#    - Copy "Username / Instance ID" -> GRAFANA_CLOUD_LOKI_USER
# 5. For API Token: Under "Security" -> "Access Policies" or "API Keys":
#    - Create a token with scopes: `metrics:write`, `logs:write`
#    - Copy token -> GRAFANA_CLOUD_API_TOKEN
# ==============================================================================

# --- Grafana Cloud Prometheus Metrics (Remote Write) ---
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-10-prod-us-central-0.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=1234567

# --- Grafana Cloud Loki Logs (Log Ingestion) ---
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-006.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=123456

# --- Shared Grafana Cloud Access Policy Token / API Key ---
GRAFANA_CLOUD_API_TOKEN=glc_eyJvIjoi...

# --- Local ClinixVault Service Scrape Endpoints ---
CLINIXVAULT_METRICS_HOST=127.0.0.1
CLINIXVAULT_METRICS_PORT=8000
CLINIXVAULT_METRICS_PATH=/metrics
CLINIXVAULT_LOG_DIR=/Users/samarthbhandegaonkar/Desktop/clinixvault/logs

GATEWAY_METRICS_TARGET=127.0.0.1:8000
VLM_METRICS_TARGET=127.0.0.1:8001
LLM_METRICS_TARGET=127.0.0.1:8002
AUDIO_METRICS_TARGET=127.0.0.1:8003
DOCUMENT_METRICS_TARGET=127.0.0.1:8004
